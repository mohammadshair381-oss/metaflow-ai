# ─────────────────────────────────────────────────────────────────────────────
# MetaFlow AI — environment variable reference
#
# This file documents every variable and contains NO real values.
# Local development works without any env file (safe defaults are built in).
#
# To override values locally:
#   backend   → copy the BACKEND section into  backend/.env
#   frontend  → copy the FRONTEND section into frontend/.env.local
# Both files are git-ignored. Never commit real values.
#
# Production values live in the Render and Vercel dashboards, not in files.
# See docs/deployment.md.
# ─────────────────────────────────────────────────────────────────────────────


# ═════ BACKEND ═════ backend/.env locally · Render → Environment in production

# development | test | production. Render: production.
NODE_ENV=development

# Port the API listens on. Render sets PORT itself; do not set it there.
PORT=4000

# debug | info | warn | error
LOG_LEVEL=info

# MongoDB connection string. SECRET.
# Optional locally (readiness then reports the database as "not_configured").
# Required in production. Atlas format:
#   mongodb+srv://<user>:<password>@<cluster-host>/metaflow?retryWrites=true&w=majority
# URL-encode special characters in the password.
MONGODB_URI=

# Frontend origins allowed to call the API with cookies, comma-separated.
# Exact origins only: no wildcard, no path, no trailing slash. https only in production.
# Defaults to http://localhost:3000 outside production.
CORS_ORIGINS=http://localhost:3000

# Reverse-proxy hops to trust for client IP and protocol. Local: 0. Render: 1.
TRUST_PROXY=0

# Set automatically by Render (do not set it yourself): reported by /api/health as "commit".
# RENDER_GIT_COMMIT=

# Session lifetime in days (1-90). Sessions are not extended; signing in again starts a new one.
SESSION_TTL_DAYS=7

# SameSite attribute of the session cookie: lax | strict | none.
# "lax" for local development and for app./api. subdomains of one domain (recommended).
# "none" only in production for a cross-site setup (*.vercel.app -> *.onrender.com); it is
# unreliable across browsers. See docs/architecture.md, "Cross-site cookies".
SESSION_COOKIE_SAMESITE=lax


# ── Social account connection (Meta: Facebook Pages and Instagram) ──
# Optional as a group. With all four empty, the API runs and the Social Accounts page says
# connecting is not set up. With only some set, the API refuses to start.
# Step-by-step: docs/meta-setup.md

# Numeric App ID from the Meta app dashboard (App settings → Basic).
META_APP_ID=

# App secret from the same page. SECRET.
META_APP_SECRET=

# Must match a "Valid OAuth Redirect URI" in the Meta app exactly, and end with
# /api/social/meta/callback. Local: http://localhost:3000/api/social/meta/callback
# Production: https://<your app domain>/api/social/meta/callback (https required).
META_REDIRECT_URI=

# Key(s) that encrypt stored social access tokens (AES-256-GCM). SECRET.
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: put the new key first and keep the old one after a comma.
# Losing the key means every account has to be reconnected.
SOCIAL_TOKEN_ENCRYPTION_KEYS=

# Graph API version. Optional; defaults to the version the code was written against.
# META_GRAPH_API_VERSION=v27.0


# ── AI generation (AI Studio) ──
# Optional as a group. With all three empty, the API runs and AI Studio says generation is
# not set up. With only some set, the API refuses to start. Step-by-step: docs/ai-setup.md

# anthropic | openai | gemini
AI_PROVIDER=

# The provider's model ID, e.g. claude-opus-5-5. It must support structured (JSON) output.
AI_MODEL=

# The provider's API key. SECRET. Server-side only: never put it in a VITE_ variable.
AI_API_KEY=

# Optional, both or neither: US dollars per million tokens for the configured model, from the
# provider's price list. Without them, costs are not estimated.
# AI_PRICE_INPUT_PER_MTOK_USD=
# AI_PRICE_OUTPUT_PER_MTOK_USD=

# ── Media library (uploaded photos and videos) ──
# Where uploaded files are stored. Only "local" (a directory on the server's disk) exists today;
# cloud storage (S3-compatible) is a later addition behind the same interface.
# Development: leave both unset and files go to backend/.data/media (git-ignored).
# Test and production: uploads stay OFF (503) until MEDIA_LOCAL_DIR is set; production needs an
# absolute path. On Render, a plain service disk is wiped on every deploy: attach a persistent
# disk and point MEDIA_LOCAL_DIR at it, or wait for cloud storage. Not a secret, but never
# shown to clients.
# MEDIA_STORAGE_DRIVER=local
# MEDIA_LOCAL_DIR=/var/data/metaflow-media

# Upload size limits in megabytes (defaults 10 and 100). Images 1–50, videos 1–1024.
# MEDIA_MAX_IMAGE_MB=10
# MEDIA_MAX_VIDEO_MB=100


# ═════ FRONTEND ═════ frontend/.env.local locally · Vercel → Environment Variables

# Public origin of the backend, without /api and without a trailing slash.
# Embedded into the browser bundle at BUILD time and visible to everyone:
# never put secrets in VITE_* variables (the build refuses secret-looking names).
# Leave it EMPTY locally: the app then calls /api on its own origin and the Vite dev/preview
# server proxies that to the local backend (no CORS involved).
# Required on Vercel, e.g. https://metaflow-api.onrender.com (the build fails without it).
VITE_API_BASE_URL=

# Build-tool setting, NOT exposed to the browser: where the Vite dev/preview proxy sends /api.
# Default: http://localhost:4000
# API_PROXY_TARGET=http://localhost:4000


# ═════ TESTS (optional) ═════ shell environment only

# A DISPOSABLE MongoDB database for the live database test suite. Never use production.
# When unset, those tests are skipped.
# MONGODB_TEST_URI=
