# ── Dependencies ────────────────────────────────────────────────
node_modules/
.pnpm-store/
# This is a pnpm workspace: pnpm-lock.yaml is the only lockfile. A stray npm or yarn
# lockfile would make Vercel/Render pick the wrong package manager.
package-lock.json
yarn.lock

# ── Build output and caches ────────────────────────────────────
dist/
build/
out/
.turbo/
.vercel/
.cache/
coverage/
*.tsbuildinfo
# Build output of the former Next.js frontend; may linger in old checkouts. Safe to delete.
.next/
next-env.d.ts

# ── Environment files and secrets ──────────────────────────────
# Real environment files must never be committed. Only templates are tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets/

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── OS and editor files ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ── Local agent settings ───────────────────────────────────────
.claude/settings.local.json
