# ── Dependencies ────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output and caches ────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
.vercel/
.cache/
coverage/
*.tsbuildinfo
# Regenerated by Next.js on every dev/build/typegen run
next-env.d.ts

# ── Environment files and secrets ──────────────────────────────
# Real environment files must never be committed. Only templates are tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets/

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── OS and editor files ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ── Local agent settings ───────────────────────────────────────
.claude/settings.local.json
